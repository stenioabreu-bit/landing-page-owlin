# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# /index, /index.html, /servicos/index e /servicos/index.html vão para o endereço da pasta
# (evita a mesma página em dois endereços)
RewriteCond %{THE_REQUEST} \s/+(.+/)?index(?:\.html)?[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serviços que saíram do site ou mudaram de endereço (relatório de SEO de 02/10/2026)
RewriteRule ^servicos/(marketing-digital|analytics|consultoria-digital)(\.html)?/?$ /servicos/ [R=301,L]
RewriteRule ^servicos/desenvolvimento-web(\.html)?/?$ /servicos/site-institucional [R=301,L]
RewriteRule ^servicos/seo-conteudo(\.html)?/?$ /servicos/seo [R=301,L]

# Redirect .html URLs to clean URLs (do this first)
RewriteCond %{THE_REQUEST} ^GET\ /(.*)\.html\ HTTP
RewriteRule (.*)\.html$ /$1 [R=301,L]

# Remove trailing slash (optional)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# Add .html extension internally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Force HTTPS (optional but recommended)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Custom 404 page (optional)
ErrorDocument 404 /404.html
